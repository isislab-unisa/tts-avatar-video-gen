#####################################
# FRONTEND - Next.js Configuration
#####################################

# Better Auth Secret (REQUIRED)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Better Auth URL where OAuth callbacks are handled
# Format: http://domain (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Public URL for frontend auth client (exposed to browser)
# Must match BETTER_AUTH_URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# URL user is redirected to after email verification
EMAIL_VERIFICATION_CALLBACK_URL=http://localhost:3000/email-verified

# MongoDB connection string for user storage and authentication
# Local: mongodb://localhost:27017/dubme
# Docker: mongodb://mongo:27017/dubme
MONGODB_URI=mongodb://localhost:27017/dubme

# Google OAuth Provider (OPTIONAL)
# Get from: https://console.cloud.google.com
# 1. Create project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# Leave empty if not using Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth Provider (OPTIONAL)
# Get from: https://github.com/settings/developers
# 1. New OAuth App
# 2. Copy Client ID and Secret
# Leave empty if not using GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email Service Configuration (OPTIONAL)
# For sending email verification and password recovery emails
# Using Gmail App Password (NOT regular password):
# https://support.google.com/accounts/answer/185833
# Leave empty if not using email verification
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password

# Backend API URLs
# Public URL exposed to browser for API calls
# Format: http://domain:port (no trailing slash)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000

# Server-side backend URL (used by Next.js server components)
# Can be different from public URL
# Local: http://localhost:4000
# Docker: http://backend:4000
BACKEND_API_URL=http://localhost:4000

# JWT Secret for token validation (REQUIRED)
# Must be same as API_JWT_SECRET in backend
# Generate with: openssl rand -base64 32
API_JWT_SECRET=your_jwt_secret_here


#####################################
# BACKEND - Go Fiber API Server
#####################################

# Internal port where Go API server listens
# In Docker: exposed to host via docker-compose port mapping
PORT=4000

# MongoDB Configuration
# Host for MongoDB connection
# Local: mongodb://localhost:27017
# Docker: mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
# Where projects, directories, and metadata are stored
MONGO_DB=dubme

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
# Local development: http://localhost:3000
# Docker: http://localhost:3000,http://frontend:3000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# JWT Secret for token validation (REQUIRED)
# Must be same as API_JWT_SECRET in frontend
# Generate with: openssl rand -base64 32
API_JWT_SECRET=your_jwt_secret_here

# Test Video Asset (TEMPORARY - for fallback scenarios)
# Path to test MP4 file (relative to backend/ directory)
# Used when Flask server is unavailable or fails
# Example values:
#   assets/test.mp4           (for local development)
#   /app/assets/test.mp4      (for Docker)
GENERATOR_TEST_MP4=assets/test.mp4

# Flask/Python Generator Service URL
# Points to the TTS + Video Generation service
# Local development: http://localhost:7001 or http://host.docker.internal:7001
# Docker Compose: http://generator:7001 (service name in network)
# Production: https://your-generator-service.com:7001
GENERATOR_URL=http://generator:7001

#####################################
# STORAGE - MinIO S3-Compatible
#####################################

# MinIO Server Endpoint
# Format: host:port (no http:// or https://)
# Local: localhost:9000
# Docker: minio:9000
MINIO_ENDPOINT=localhost:9000

# MinIO Admin Username
# Default for local development: minioadmin
# Change in production!
MINIO_ROOT_USER=minioadmin

# MinIO Admin Password
# Default for local development: minioadmin
# Change in production with strong password!
MINIO_ROOT_PASSWORD=minioadmin

# MinIO Bucket Name
# S3 bucket where generated videos are stored
# Convention: lowercase, no special characters
MINIO_BUCKET=dubme

# Use SSL for MinIO Connection
# false: http (development)
# true: https (production)
MINIO_USE_SSL=false

# Public URL for accessing MinIO files
# Used for direct file links and CDN configuration
# Local: http://localhost:9000
# Production: https://your-minio-domain.com
MINIO_PUBLIC_URL=http://localhost:9000

#####################################
# DEVELOPMENT MODE
#####################################

# Enable Development Mode
# true = Bypass authentication (for local development)
# false = Normal authentication required (production)
# 
# When DEV_MODE=true:
#   - Login page skipped
#   - Auto-login with dev user
#   - No email verification required
#   - All API endpoints accessible
#   - Error messages are verbose
#   - CORS is relaxed
#   - Rate limiting disabled
#
# When DEV_MODE=false:
#   - Full authentication required
#   - JWT tokens validated
#   - Email verification required
#   - Rate limiting enabled
#   - Generic error messages
#   - Strict CORS policy
#
# IMPORTANT: Always set to 'false' in production!
DEV_MODE=true

# Development User ID
# Only used when DEV_MODE=true
# Can be any string identifier
DEV_USER_ID=dev-user-local
